# This project has no build step (plain HTML + ES modules), so these
# values are NOT read from .env at runtime. They're documented here as
# a reference; the real values go directly into
# src/database/supabaseClient.js (SUPABASE_URL / SUPABASE_ANON_KEY).
#
# The anon key is meant to be public and safe to ship in client code;
# access is enforced by the Row Level Security policies in
# src/database/schema.sql, not by keeping this key secret.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
